  "cases": [
    {
      "id": "sharp_six_machine_five_job",
      "purpose": "Exact 32-state sharpness audit at eta=gamma=1/8; this finite test is not a general theorem proof.",
      "T": "1",
      "machines": ["H1", "H2", "A", "Bm", "R", "S"],
      "jobs": [
        {"id": "q1", "processing": {"H1": "1/8", "A": "1"}},
        {"id": "q2", "processing": {"H2": "1/8", "Bm": "1"}},
        {"id": "x1", "processing": {"A": "1", "R": "1/2"}},
        {"id": "x2", "processing": {"Bm": "1", "R": "1/2"}},
        {"id": "f", "processing": {"R": "7/8", "S": "1"}}
      ],
      "sigma0": {"q1": "H1", "q2": "H2", "x1": "A", "x2": "Bm", "f": "R"},
      "sigma1": {"q1": "A", "q2": "Bm", "x1": "R", "x2": "R", "f": "S"},
      "queries": ["q1", "q2"],
      "nonquery_move_weights": {"x1": "0", "x2": "0", "f": "1"},
      "requested_queries": ["q1", "q2"],
      "expected": {
        "A_q": {"q1": ["x1"], "q2": ["x2"]},
        "trigger_order": [{"machine": "A", "color": "q1"}, {"machine": "Bm", "color": "q2"}],
        "uncolored_nonquery": ["f"],
        "tau": {
          "q1": {"peak": "11/8", "delta": "1/8", "bound": "3/2", "fee": "0"},
          "q2": {"peak": "11/8", "delta": "1/8", "bound": "3/2", "fee": "0"}
        }
      },
      "enumeration": {
        "state_limit": 32,
        "expected_state_count": 32,
        "require_all_finite_endpoint_schedules_covered": true,
        "threshold_checks": [
          {"query_subset": ["q1"], "cap": "4/3", "expected_min_fee": "1", "mandatory_nonquery_contains": ["f"]},
          {"query_subset": ["q2"], "cap": "4/3", "expected_min_fee": "1", "mandatory_nonquery_contains": ["f"]},
          {"query_subset": ["q1"], "cap": "11/8", "expected_min_fee": "0"},
          {"query_subset": ["q2"], "cap": "11/8", "expected_min_fee": "0"}
        ],
        "minimum_peak_checks": [
          {"query_subset": ["q1"], "fee_at_most": "0", "expected_min_peak": "11/8"},
          {"query_subset": ["q2"], "fee_at_most": "0", "expected_min_peak": "11/8"},
          {"query_subset": ["q1"], "fee_at_most": "1", "expected_min_peak": "1"},
          {"query_subset": ["q2"], "fee_at_most": "1", "expected_min_peak": "1"}
        ]
      }
    },
    {
