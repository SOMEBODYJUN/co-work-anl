  "proposals": [
    {
      "id": "RA12-VIS-OBS-01",
      "final_finding_id": "RA12-VIS-FINAL-242D-01",
      "check_id": "RA12-REGION-p0001-r1c2-P2",
      "field": "observation",
      "source_ids": [
        "RA12-P001-U02",
        "RA12-P001-U03",
        "RA12-P001-U07",
        "RA12-P001-U05"
      ],
      "region_ids": [
        "p0001-r1c1",
        "p0001-r1c2"
      ],
      "proposed_text": "本区左缘只接第一条“区间并”的末笔，其余原则段留白。下缘是例题题面右半，写有 ∀ε>0、∃、首下标近 i 的 I_i 到 I_n 的区间列，接“开区间”的右框和 s.t.。",
      "forward_validation": {
        "method": "从右区起点直渲局部并与三个完整源行及右区整彩图对读",
        "result": "在基准 x=1553 处起切的 800 dpi 图左缘，只见首条「间」的右部及「并」。U02 从编号到末字连续，U03 和 U07 的尾字分别留在各自左侧完整行；U05 和右上整区共同见下方的全称误差、存在号、区间列与 s/t。"
      },
      "backward_validation": {
        "method": "把候选所需笔画投回右区 x 阈值，并以登记来源核对",
        "result": "右上区 x0=1553。U02 源框 x1=1705 跨界，裁图中「是」约在 x=1014–1088；U03、U07 源框 x1 分别为 1325、1535。后两框连外部空白边距都在右区外，右区原来源 U02/U05 能解释其实际两处墨迹。"
      },
      "certainty": "高，局部覆盖由同一物理页的原墨和裁切边界共同确定。首区间下标沿用近 i 的限定。",
      "evidence_paths": [
