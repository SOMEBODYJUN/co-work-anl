        {
          "id": "c3",
          "reading": "〔V 及括形〕Q_k 的根是代数整数",
          "assessment": "保留首左的两个相近弧及其连笔，右括清楚，左括下缘与 Q 圈下缘部分相触。",
          "evidence_paths": [
            "audit/source-units-800/CA07-P001-U09-800.png",
            "proposals/ca07_math/recovery/crops/p1-U09-ring-roots-1200.png",
            "proposals/ca07_visual/recovery/crops/p1-roots-head-1200.png",
            "audit/source-units-800/CA07-P001-U11-800.png"
          ]
        }
      ],
      "observation": "起首深谷形与 p1 U11 已知 V 的长谷同势。其后另窄曲势在 Q 大圈前收，右边长闭括清楚。大圈下端有穿出斜笔与 k 小尾，对照 U06 的同一圈尾及 U02 的 Q，比无尾 O 贴合。接「的」后，左件长竖贯长横并有左下折，右件上弓、内短直及粗回锋，较近木、艮的连写。紧跟「是代数整数」。左括和右件内笔并未逐笔全开。",
      "forward_validation": {
        "method": "为优先读法给出成立的数学释义",
        "result": "若所指是首一且代数整数系数的方程，设系数为 c_i，在共同扩域取 D=Z[c_i]。有界幂积给 D 是有限 Z 模，首一式给 D[α] 是有限 D 模，两组生成元的乘积给 D[α] 是有限 Z 模。作用于 1 的乘法矩阵判据给 α 整于 Z。"
      },
      "backward_validation": {
        "method": "分辨遗漏条件与可替代词义",
        "result": "只假设系数是代数整数，2T−1 的根 1/2 已反驳。只给 Q_k 或 O_k 这个环也未说明 V 的具体输入或方程。代数整数的和确实仍整，所以该定理本身不能排除「和」，需要从木旁和右部判断。"
      },
      "disposition": "接受「V(Q_k) 的根是代数整数」为上下文读法，V 与左括之间的接笔留注。蓝释写明首一条件，Q_k 的原记号和规范 O_k 分开。"
    },
