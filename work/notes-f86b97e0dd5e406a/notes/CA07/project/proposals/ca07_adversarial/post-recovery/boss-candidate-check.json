      ],
      "problem": "乘 b 标量式下的短题「线性：」或「对比：」",
      "candidates": [
        {
          "id": "c1",
          "text": "「线性：」，性为压缩的长竖旁和右折连写。"
        },
        {
          "id": "c2",
          "text": "「对比：」；首字作对，右字作比。"
        },
        {
          "id": "c3",
          "text": "「取基／取法：」或只保留可见符形，理解为下面矩阵的引字。"
        }
      ],
      "decision": "accept_contextual",
      "selected_candidate_id": "c1",
      "reason": "最强判据是本篇确写「曲线」的线有近同形上下折和右斜交。次字右部一横接两转，接受性字连写保留低笔，不能在原图逐点重建忄。右尾两点实见。",
      "return_to_image": "800 与 1200 同样见首左顶横斜向下折并回卷，右部两长斜交，附轻折。P1 U10 曲线的线左高横下回卷、右交斜与此极相近。第二字左一长竖下微挑，中间细连向右，右先从高处落折成横，再中弯及低部回锋，可理解为忄旁和生的草写，和 P5 U09、P2 U01 生字下转的写法可作对照。右笔多一道横折，单作比的右匕解释较弱。",
      "forward_validation": {
        "method": "把短标题检查成前后证明的连接",
        "inputs": "φ_b(u)=bu，其左邻标量式和右邻的生成元展开",
        "result": "分别用交换律得 φ_b(λu)=λφ_b(u)，用分配律得加法式。线性连接到选 d_{ij} 解释顺畅。"
      },
      "backward_validation": {
        "method": "用同手字形及非自由模核查其他候选",
        "inputs": "P1「曲线」样笔，A=Z，M=Z[ε]/(2ε,ε²)",
        "result": "对比并不违反语义，却缺首字对字的寸部的正向墨证。若进一步读成取基而建立证明，本例的非零扭元说明有限生成可以无基。"
      },
