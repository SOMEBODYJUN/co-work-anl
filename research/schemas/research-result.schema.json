{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "Saved research continuation event",
  "description": "The event created by research save, not a mathematical truth certificate. The full result is the referenced immutable note.",
  "required": [
    "event_id",
    "continuation_of",
    "solver_id",
    "profile",
    "note",
    "next_action",
    "state",
    "agent_id",
    "feedback"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "continuation_of": {
      "type": [
        "string",
        "null"
      ]
    },
    "solver_id": {
      "type": "string",
      "minLength": 1
    },
    "profile": {
      "enum": [
        "obstacle",
        "full"
      ]
    },
    "note": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "section": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "next_action": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "enum": [
        "working",
        "needs-feedback",
        "blocked",
        "candidate",
        "paused",
        "closed"
      ]
    },
    "agent_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "feedback": {
      "type": [
        "string",
        "null"
      ]
    },
    "latest_event": {
      "type": "string"
    },
    "feedback_inherited": {
      "type": "boolean",
      "description": "True when this save retained the preceding concrete feedback."
    }
  },
  "additionalProperties": true
}
