{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "Research packet generated by work.py",
  "description": "Documents the actual obstacle/full input. It is not mathematical acceptance or a model launch.",
  "required": [
    "problem_id",
    "profile",
    "target",
    "definitions",
    "obstacles",
    "task",
    "launch",
    "limit"
  ],
  "properties": {
    "problem_id": {
      "type": "string",
      "minLength": 1
    },
    "profile": {
      "enum": [
        "obstacle",
        "full"
      ]
    },
    "target": {
      "type": "string"
    },
    "definitions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "obstacles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "task": {
      "type": "string",
      "minLength": 1
    },
    "launch": {
      "type": "object",
      "required": [
        "fork_turns",
        "instruction"
      ],
      "properties": {
        "fork_turns": {
          "type": "string"
        },
        "instruction": {
          "type": "string"
        }
      }
    },
    "limit": {
      "type": "string"
    },
    "context": {
      "type": "object",
      "description": "Complete selected ALL-premise support options, separate alternative proof branches and research leads; current bodies are read on demand."
    },
    "retrieval": {
      "type": "object",
      "properties": {
        "registry": {
          "type": "string"
        },
        "commands": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "registry_pin": {
      "type": "string"
    },
    "input_refs": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
