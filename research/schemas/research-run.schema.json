{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "Research run generated by research init/save",
  "description": "Local recoverable state. Agents and remote publication are reported separately by the actual platform and checkpoint.",
  "required": [
    "schema",
    "run_id",
    "problem_id",
    "state",
    "spec",
    "spec_pin",
    "registry",
    "solvers",
    "packet_pins",
    "note"
  ],
  "properties": {
    "schema": {
      "const": 2
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "problem_id": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "type": "string"
    },
    "spec": {
      "type": "string"
    },
    "spec_pin": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "registry": {
      "type": "string"
    },
    "registry_pin": {
      "type": "string"
    },
    "packet_pins": {
      "type": "object",
      "required": [
        "obstacle",
        "full"
      ],
      "properties": {
        "obstacle": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "full": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "solvers": {
      "type": "object",
      "additionalProperties": {
        "$ref": "research-result.schema.json"
      }
    },
    "note": {
      "type": "string"
    },
    "context_snapshot": {
      "type": "object",
      "description": "Initial registration and relation pins for targeted version-change recovery.",
      "properties": {
        "objects": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "edges": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  },
  "additionalProperties": true
}
