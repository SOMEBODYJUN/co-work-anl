{
  "claim": "path_relaxation_feasible_does_not_imply_count_strategy_spe",
  "model": {
    "players": 2,
    "labels": [0, 1, 2, 3],
    "actual_path": [0, 1],
    "comparison_tuple": [2, 3],
    "customer_types": [
      {"interest": [0], "mass": "1"},
      {"interest": [1], "mass": "2"},
      {"interest": [2], "mass": "3/2"}
    ]
  },
  "path_variables": {
    "w_(mask=1,d=0)": "1",
    "w_(mask=2,d=0)": "2",
    "w_(mask=0,d=1)": "3/2",
    "target_position": 0,
    "normalized_payoffs": {"u_0": "1", "u_1": "2"}
  },
  "exact_path_rows": [
    {"position": 0, "row": "actual t=0", "lhs": "1/2", "rhs_u": "1"},
    {"position": 0, "row": "actual t=1", "lhs": "1", "rhs_u": "1"},
    {"position": 0, "row": "average comparison d/2", "lhs": "3/8", "rhs_u": "1"},
    {"position": 1, "row": "actual t=0", "lhs": "1/2", "rhs_u": "2"},
    {"position": 1, "row": "actual t=1", "lhs": "2", "rhs_u": "2"},
    {"position": 1, "row": "average comparison d/2", "lhs": "3/4", "rhs_u": "2"}
  ],
  "why_no_full_count_spe_extends_path": {
    "on_path_after_action_0": {
      "player_2_payoffs_by_action": {"0": "1/2", "1": "2", "2": "3/2", "3": "0"},
      "unique_best_response": 1
    },
    "after_root_deviation_to_2": {
      "player_2_payoffs_by_action": {"0": "1", "1": "2", "2": "3/4", "3": "0"},
      "unique_best_response": 1,
      "deviating_player_1_payoff": "3/2",
      "on_path_player_1_payoff": "1",
      "strict_root_violation": "3/2 > 1"
    }
  },
  "conclusion": "The path rows hold exactly, including the averaged comparison row, but every complete strategy whose on-path actions are (0,1) has the same forced real successor after a root deviation to 2 and therefore fails root IC. The path relaxation omitted the off-path label 2 and used the denominator b_j+r_j, so it cannot certify the complete count-policy IC cone."
}
