{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "source_pdf": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "original_name": {
          "type": "string",
          "minLength": 1
        },
        "page_count": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "path",
        "sha256",
        "original_name",
        "page_count"
      ],
      "additionalProperties": false
    },
    "render": {
      "type": "object",
      "properties": {
        "dpi": {
          "type": "integer",
          "minimum": 36,
          "maximum": 1200
        },
        "columns": {
          "const": 2
        },
        "rows": {
          "const": 3
        },
        "overlap_fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.45
        },
        "pymupdf_version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "dpi",
        "columns",
        "rows",
        "overlap_fraction",
        "pymupdf_version"
      ],
      "additionalProperties": false
    },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "number": {
            "type": "integer",
            "minimum": 1
          },
          "width_px": {
            "type": "integer",
            "minimum": 1
          },
          "height_px": {
            "type": "integer",
            "minimum": 1
          },
          "image": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "bbox_px": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0
                },
                "minItems": 4,
                "maxItems": 4
              }
            },
            "required": [
              "path",
              "sha256",
              "bbox_px"
            ],
            "additionalProperties": false
          },
          "regions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "row": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 3
                },
                "column": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 2
                },
                "bbox_px": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "minItems": 4,
                  "maxItems": 4
                },
                "image": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    }
                  },
                  "required": [
                    "path",
                    "sha256"
                  ],
                  "additionalProperties": false
                },
                "blank_candidate": {
                  "type": "boolean"
                },
                "blank_status": {
                  "const": "unreviewed"
                }
              },
              "required": [
                "id",
                "row",
                "column",
                "bbox_px",
                "image",
                "blank_candidate",
                "blank_status"
              ],
              "additionalProperties": false
            },
            "minItems": 6,
            "maxItems": 6
          }
        },
        "required": [
          "id",
          "number",
          "width_px",
          "height_px",
          "image",
          "regions"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "source_pdf",
    "render",
    "pages"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "manifest.schema.json",
  "title": "Full PDF page and region manifest"
}
